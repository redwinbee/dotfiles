# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'

PS1='\[\e[38;5;242m\][\A]\[\e[0m\] \[\e[38;5;217m\]\h\[\e[38;5;242m\]:\[\e[38;5;180m\]\W\[\e[0m\] \[\e[38;5;242m\]|\[\e[0m\] '

unset SSH_AGENT_PID
if [ "${gnupg_SSH_AUTH_SOCK_by:-0}" -ne $$ ]; then
  export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
fi
export GPG_TTY=$(tty)
gpg-connect-agent 'keyattr 47A262D18501B20D9A9E2AEA47642280EEFA3315 Use-for-ssh: true' updatestartuptty /bye >/dev/null
